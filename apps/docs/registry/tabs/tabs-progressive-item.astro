---
import { tabsContent } from "./tabs.tv";
import { cn } from "../lib/utils";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div
  role="tabpanel"
  data-ui26-tab-item
  data-label={label}
  class={cn(tabsContent(), "ui26-tab-panel", className)}
>
  <slot />
</div>
