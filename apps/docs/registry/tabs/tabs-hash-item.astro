---
import { tabsContent } from "./tabs.tv";
import { cn } from "../lib/utils";

interface Props {
  hash: string;
  label: string;
  base: string;
  class?: string;
}

const { hash, base, class: className } = Astro.props;
---

<div
  role="tabpanel"
  id={`${base}-${hash}`}
  data-ui26-hash-panel
  data-hash={hash}
  data-label={Astro.props.label}
  class={cn(tabsContent(), "ui26-hash-panel", className)}
>
  <slot />
</div>
