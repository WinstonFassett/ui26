---
import { cn } from "../lib/utils";
import { radioGroup } from "./radio-group.tv";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "class"> & { class?: string };

const { class: className, ...rest } = Astro.props;
---

<div role="radiogroup" class={cn(radioGroup(), className)} {...rest}>
  <slot />
</div>
