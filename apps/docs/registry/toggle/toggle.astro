---
import { cn } from "../lib/utils";
import { toggle, type ToggleVariants } from "./toggle.tv";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"button">, "class"> &
  ToggleVariants & {
    class?: string;
    pressed?: boolean;
  };

const { variant, size, pressed, class: className, ...rest } = Astro.props;
---

<button
  type="button"
  aria-pressed={pressed}
  class={cn(toggle({ variant, size }), className)}
  {...rest}
>
  <slot />
</button>
