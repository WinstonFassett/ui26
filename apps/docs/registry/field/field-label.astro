---
import { cn } from "../lib/utils";
import Label from "../label/label.astro";
import { fieldLabel } from "./field.tv";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"label">, "class"> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<Label data-slot="field-label" class={cn(fieldLabel(), className)} {...rest}>
  <slot />
</Label>
