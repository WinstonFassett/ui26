---
import { codeToHtml } from "shiki";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { CopyBtn } from "@/components/livecode/CopyBtn";
import { SHIKI_CLASSES } from "@/lib/shiki-classes";
import type { Spec } from "@/lib/spec-to-code";

interface Props {
  spec: Spec;
}

const { spec } = Astro.props;
const code = JSON.stringify(spec, null, 2);
const html = await codeToHtml(code, {
  lang: "json",
  themes: { light: "github-light", dark: "github-dark-default" },
});
---

<section class="not-content my-8">
  <div class="border border-border p-6">
    <BlockPreview spec={spec} client:load />
  </div>
  <details class="mt-4 border border-border bg-card group">
    <summary class="flex items-center gap-2 px-3.5 py-2 cursor-pointer list-none select-none">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground shrink-0">
        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <span class="font-mono text-[11px] text-muted-foreground group-open:text-foreground transition-colors">
        <span class="group-open:hidden">View JSON spec</span>
        <span class="hidden group-open:inline">Hide JSON spec</span>
      </span>
      <span class="flex-1" />
      <div onclick="event.stopPropagation()">
        <CopyBtn text={code} client:load />
      </div>
    </summary>
    <div class="border-t border-border">
      <div class={SHIKI_CLASSES} set:html={html} />
    </div>
  </details>
</section>

<style is:global>
  :root[data-theme$="dark"] .shiki span {
    color: var(--shiki-dark) !important;
  }
</style>
