---
import { getSamples } from "@/samples";
import { prerenderFiles } from "@/lib/prerender-source";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { DocCodeBlock } from "./DocCodeBlock";

interface Props {
  relatedComponent: string;
  group: string;
}

const { relatedComponent, group } = Astro.props;

const samples = getSamples({ kind: "atom", relatedComponent, group });
const rendered = await Promise.all(
  samples.map(async (s) => ({
    sample: s,
    files: await prerenderFiles(s.spec, s.componentName, s.id),
  }))
);
---

{rendered.map(({ sample, files }) => (
  <section class="my-8">
    <div class="not-content">
      <div class="border border-border p-6">
        <BlockPreview spec={sample.spec} client:load />
      </div>
      <div class="mt-4">
        <DocCodeBlock client:load files={files} />
      </div>
    </div>
  </section>
))}
