---
import { getSamples } from "@/samples";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { CLI_ADD } from "@/lib/site";

const SHOW = ["ticket-card", "kpi-strip", "sign-in-form", "activity-feed", "command-palette", "ai-message"];
const featured = getSamples({ kind: "block", featured: true }).filter((b) => SHOW.includes(b.id)).sort((a, b) => SHOW.indexOf(a.id) - SHOW.indexOf(b.id));
---

<section class="not-content mt-16">
  <div class="flex items-center gap-3 mb-6">
    <div class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted-foreground">Featured blocks</div>
    <div class="flex-1 h-px bg-border" />
    <a href="/blocks/" class="font-mono text-[10px] tracking-[0.12em] uppercase text-accent hover:underline">All blocks →</a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {featured.map((b) => (
      <a href={`/blocks/#${b.id}`} class="block border border-border rounded overflow-hidden bg-card hover:border-accent/60 transition-colors no-underline">
        <div class="p-4">
          <BlockPreview spec={b.spec} client:load />
        </div>
        <div class="border-t border-border px-4 py-3">
          <div class="font-mono text-[11px] text-accent">{b.id}</div>
          <p class="text-[12px] text-muted-foreground mt-1 leading-snug">{b.description}</p>
          <code class="block font-mono text-[11px] text-muted-foreground mt-2 opacity-70">{CLI_ADD} {b.id}</code>
        </div>
      </a>
    ))}
  </div>
</section>
