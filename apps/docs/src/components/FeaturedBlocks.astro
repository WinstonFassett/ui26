---
import { getSamples } from "@/samples";
import { BlockPreview } from "@/components/livecode/BlockPreview";

const SHOW = ["ticket-card", "kpi-strip", "sign-in-form", "activity-feed", "command-palette", "ai-message"];
const featured = getSamples({ kind: "block", featured: true }).filter((b) => SHOW.includes(b.id)).sort((a, b) => SHOW.indexOf(a.id) - SHOW.indexOf(b.id));
---

<section class="mb-12 not-content">
  <header class="mb-5 flex items-baseline justify-between border-b border-border pb-2">
    <h2 class="font-serif text-[22px] font-medium tracking-tight">Featured blocks</h2>
    <a href="/blocks/" class="font-mono text-[10px] uppercase tracking-wider text-accent hover:underline">All blocks →</a>
  </header>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
    {featured.map((b) => (
      <a
        href={`/blocks/#${b.id}`}
        class="ex-card group relative block border border-border bg-card hover:border-accent transition-colors overflow-hidden"
      >
        <div class="ex-card-preview pointer-events-none overflow-hidden p-6">
          <BlockPreview spec={b.spec} client:load />
        </div>
        <div class="ex-card-info absolute bottom-0 left-0 right-0 flex flex-col gap-0.5 px-4 py-3 bg-card/90 backdrop-blur-sm border-t border-border translate-y-full group-hover:translate-y-0 transition-transform duration-150">
          <span class="text-[13px] font-medium text-foreground leading-snug">{b.title}</span>
          {b.description && (
            <span class="text-[11px] text-muted-foreground leading-snug">{b.description}</span>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .ex-card-preview { pointer-events: none; max-height: 360px; }
</style>
