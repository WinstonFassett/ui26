---
type Props = {
  id: string;
  class?: string;
};

const { id, class: className } = Astro.props;
---

<div
  data-region-id={id}
  class={`region-wrap relative cursor-pointer p-3 -mx-3 mb-2 transition-colors border border-transparent hover:border-border hover:bg-muted/30 ${className ?? ""}`}
  role="button"
  tabindex="0"
>
  <slot />
</div>

<style is:global>
  .region-wrap[data-region-active="true"] {
    border-color: var(--sl-color-accent, hsl(var(--accent)));
    background: hsl(var(--muted) / 0.6);
  }
  .region-wrap[data-region-active="true"]::after {
    content: "shown →";
    position: absolute;
    top: -1px;
    right: -1px;
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 2px 6px;
  }
</style>
