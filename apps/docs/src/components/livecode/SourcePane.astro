---
import { cn } from "@/lib/utils";
import "./source-pane.css";
import { SHIKI_CLASSES } from "@/lib/shiki-classes";
import { FRAMEWORKS, FRAMEWORK_LABELS } from "@/lib/spec-to-code";
import { PlayroomLink } from "./PlayroomLink";
import type { RenderedFiles } from "@/lib/prerender-source";

export interface SourcePaneRegion {
  id: string;
  label: string;
  section: string;
  files: RenderedFiles;
}

interface Props {
  region: SourcePaneRegion;
  hideHeader?: boolean;
  class?: string;
  className?: string;
}

const { region, hideHeader, class: cls, className } = Astro.props;
const uid = `fwtabs-${region.id}`;
---

<div class={cn("flex flex-col bg-card border border-border h-full", cls, className)}>

  {!hideHeader && (
    <div class="flex items-center gap-2 px-3.5 py-3 border-b border-border">
      <div class="flex-1 min-w-0">
        <div class="font-mono text-[9px] uppercase tracking-widest text-accent mb-0.5">
          {region.section}
        </div>
        <div class="text-[13px] font-semibold text-foreground truncate">
          {region.label}
        </div>
      </div>
      <button type="button" class="ui26-copy inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider border transition-colors bg-foreground text-background border-foreground hover:bg-foreground/90" style="display:none">
        <svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="2.5" width="5.5" height="5.5" /><path d="M1 6V1h5" /></svg>
        <span class="ui26-copy-label">Copy</span>
      </button>
    </div>
  )}

  <!-- Framework picker: radio-based, same progressive enhancement pattern as tabs -->
  <ui26-fwtabs data-uid={uid} class="flex flex-col flex-1 min-h-0">
    {FRAMEWORKS.map((f, i) => (
      <input
        type="radio"
        class="sr-only"
        name={uid}
        id={`${uid}-${f}`}
        value={f}
        checked={f === "react" || undefined}
      />
    ))}

    <div class="flex items-stretch border-b border-border">
      {FRAMEWORKS.map((f) => (
        <label
          for={`${uid}-${f}`}
          data-fw={f}
          class="px-3 py-2 font-mono text-[10px] uppercase tracking-wider border-b-[1.5px] -mb-px transition-colors cursor-pointer border-transparent text-muted-foreground hover:text-foreground ui26-fw-label"
        >
          {FRAMEWORK_LABELS[f]}
        </label>
      ))}
      <span class="flex-1" />
      {FRAMEWORKS.map((f) => (
        <span
          data-fw-filename={f}
          class="hidden self-center px-3 font-mono text-[10px] tracking-wider lowercase text-muted-foreground ui26-fw-filename"
        >
          {region.files[f]?.filename}
        </span>
      ))}
    </div>

    <!-- All four code blocks SSR'd; CSS shows the active one -->
    <div class="flex-1 overflow-auto">
      {FRAMEWORKS.map((f) => (
        <div
          data-fw-panel={f}
          data-code={region.files[f]?.code ?? ""}
          class={cn(SHIKI_CLASSES, "ui26-fw-panel hidden")}
          set:html={region.files[f]?.html ?? ""}
        />
      ))}
    </div>

    <div class="flex items-center justify-between px-3.5 py-2 border-t border-border bg-card shrink-0">
      {FRAMEWORKS.map((f) => (
        <span data-fw-label={f} class="font-mono text-[9px] uppercase tracking-wider text-muted-foreground ui26-fw-label-bottom hidden">
          ui26/{f}
        </span>
      ))}
      <div class="ml-auto flex items-center gap-2">
        {hideHeader && (
          <button type="button" class="ui26-copy inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider border transition-colors bg-foreground text-background border-foreground hover:bg-foreground/90" style="display:none">
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="2.5" width="5.5" height="5.5" /><path d="M1 6V1h5" /></svg>
            <span class="ui26-copy-label">Copy</span>
          </button>
        )}
        {import.meta.env.DEV && <PlayroomLink code={region.files.react.code} client:load />}
      </div>
    </div>
  </ui26-fwtabs>

</div>


<script>
  const KEY = "ui26-framework";
  type Fw = "react" | "svelte" | "astro" | "json-render";

  function isFw(v: unknown): v is Fw {
    return v === "react" || v === "svelte" || v === "astro" || v === "json-render";
  }

  class Ui26FwTabs extends HTMLElement {
    connectedCallback() {
      const inputs = [...this.children].filter(
        (c): c is HTMLInputElement => c.tagName === "INPUT" && (c as HTMLInputElement).type === "radio"
      );
      const root = this.closest("div") ?? this.parentElement ?? this;
      const copyBtns = [...root.querySelectorAll<HTMLButtonElement>(".ui26-copy")];

      const activeCode = () => {
        const checked = inputs.find(i => i.checked);
        const fw = checked?.value;
        const panel = this.querySelector<HTMLElement>(`[data-fw-panel="${fw}"]`);
        return panel?.dataset.code ?? "";
      };

      copyBtns.forEach(btn => {
        btn.style.display = "";
        btn.addEventListener("click", () => {
          navigator.clipboard?.writeText(activeCode()).catch(() => {});
          const label = btn.querySelector<HTMLElement>(".ui26-copy-label");
          if (label) {
            const orig = label.textContent;
            label.textContent = "Copied";
            btn.classList.add("bg-accent", "text-accent-foreground", "border-accent");
            btn.classList.remove("bg-foreground", "text-background", "border-foreground");
            setTimeout(() => {
              label.textContent = orig;
              btn.classList.remove("bg-accent", "text-accent-foreground", "border-accent");
              btn.classList.add("bg-foreground", "text-background", "border-foreground");
            }, 900);
          }
        });
      });

      // Restore from localStorage
      const stored = localStorage.getItem(KEY);
      if (isFw(stored)) {
        const target = inputs.find(i => i.value === stored);
        if (target) target.checked = true;
      }

      // Persist on change
      inputs.forEach(input => {
        input.addEventListener("change", () => {
          if (isFw(input.value)) localStorage.setItem(KEY, input.value);
        });
      });


      // Sync across tabs/windows
      window.addEventListener("storage", (e) => {
        if (e.key === KEY && isFw(e.newValue)) {
          const target = inputs.find(i => i.value === e.newValue);
          if (target) target.checked = true;
        }
      });
    }
  }

  if (!customElements.get("ui26-fwtabs")) {
    customElements.define("ui26-fwtabs", Ui26FwTabs);
  }
</script>
