---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import RegionWrap from "@/components/livecode/RegionWrap.astro";
import { ClickDockShell } from "@/components/livecode/ClickDockShell";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { FrameworkPicker } from "@/components/livecode/FrameworkPicker";
import { CopyBtn } from "@/components/livecode/CopyBtn";
import { getSamples } from "@/samples";
import BackToDocs from "@/components/BackToDocs.astro";

const CATEGORY_ORDER = ["Cards", "Forms", "Marketing", "Feedback", "Productivity", "AI"];

const ALL_BLOCKS = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);

const GROUPED = CATEGORY_ORDER
  .map((cat) => ({
    category: cat,
    blocks: ALL_BLOCKS
      .filter((b) => b.category === cat)
      .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
  }))
  .filter((g) => g.blocks.length > 0);

const RAIL_REGIONS = ALL_BLOCKS.map((b) => ({
  id: b.id,
  label: b.title,
  section: b.category ?? "",
  spec: b.spec,
  componentName: b.componentName,
}));
---

<StarlightPage
  frontmatter={{
    title: "Blocks",
    description: "Composable, installable UI patterns. Click any block to see its source.",
    template: "splash",
  }}
>
  <style is:global>
    body:has(.blocks-page) .main-frame .content-panel .sl-container { max-width: 1440px; }
  </style>

  <div class="blocks-page blocks-with-rail">
    <main class="blocks-main">
      <BackToDocs />
      <section class="not-content mb-12">
        <div class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted-foreground mb-3">
          ui26 · blocks
        </div>
        <div class="font-serif font-medium text-[48px] leading-[1.04] tracking-[-0.022em] text-foreground">
          Composable patterns, <span class="italic text-muted-foreground">installable</span>.
        </div>
        <p class="max-w-[560px] mt-4 text-[15px] leading-[1.55] text-muted-foreground">
          Each block is a small, named composition of primitives. Click a block to see the source. Install with the CLI.
        </p>
        <div class="mt-6">
          <FrameworkPicker client:load />
        </div>
      </section>

      {GROUPED.map((group) => (
        <section class="mb-12">
          <header class="not-content mb-5 flex items-baseline justify-between border-b border-border pb-2">
            <h2 class="font-serif text-[22px] font-medium tracking-tight">{group.category}</h2>
            <span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              {group.blocks.length} block{group.blocks.length === 1 ? "" : "s"}
            </span>
          </header>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {group.blocks.map((b) => (
              <RegionWrap id={b.id} class={b.span === "full" ? "lg:col-span-2" : ""}>
                <div class="not-content">
                  <div class="mb-3 flex items-baseline gap-3">
                    <span class="font-mono text-[10px] tracking-[0.12em] uppercase text-accent">{b.id}</span>
                    {(b.registryDependencies ?? []).length > 0 && (
                      <span class="font-mono text-[10px] tracking-wider text-muted-foreground">
                        deps: {(b.registryDependencies ?? []).join(", ")}
                      </span>
                    )}
                  </div>
                  <div class="overflow-x-auto">
                    <BlockPreview spec={b.spec} client:load />
                  </div>
                  <p class="text-[12px] text-muted-foreground mt-3 leading-snug">{b.description}</p>
                  <div class="mt-3 flex items-center gap-2 border-t border-border pt-3">
                    <code class="flex-1 font-mono text-[11px] text-muted-foreground truncate">npx ui26 add {b.id}</code>
                    <CopyBtn text={`npx ui26 add ${b.id}`} label="Copy" client:load />
                  </div>
                </div>
              </RegionWrap>
            ))}
          </div>
        </section>
      ))}
    </main>

    <aside class="blocks-rail not-content">
      <div class="blocks-rail-inner">
        <ClickDockShell client:load regions={RAIL_REGIONS} />
      </div>
    </aside>
  </div>

  <style is:global>
    /* Narrow (<1100px): rail is a slide-up drawer pinned to the viewport bottom. */
    @media (max-width: 1099px) {
      .blocks-rail {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        max-height: 70vh;
        height: 70vh;
        transform: translateY(calc(100% + 8px));
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
        background: hsl(var(--background));
        border-top: 1px solid hsl(var(--border));
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        box-shadow: 0 -8px 32px -4px rgba(0, 0, 0, 0.22);
        padding-top: 12px;
      }
      body[data-rail-open="true"] .blocks-rail { transform: translateY(0); }
      body[data-rail-open="true"] { overflow: hidden; }
      .blocks-rail { overscroll-behavior: contain; }
      .blocks-rail .ks-rail-grabber { display: block; }
      .blocks-rail .ks-rail-close { top: 10px; }
    }
    @media (min-width: 1100px) {
      .blocks-with-rail { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 1.5rem; }
      .blocks-rail-inner { position: sticky; top: 5rem; height: calc(100vh - 6rem); }
    }
  </style>
</StarlightPage>
