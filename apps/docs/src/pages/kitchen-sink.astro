---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import BackToDocs from "@/components/BackToDocs.astro";
import Button from "@registry/button/button.astro";
import Badge from "@registry/badge/badge.astro";
import Card from "@registry/card/card.astro";
import CardHeader from "@registry/card/card-header.astro";
import CardTitle from "@registry/card/card-title.astro";
import CardDescription from "@registry/card/card-description.astro";
import CardContent from "@registry/card/card-content.astro";
import CardFooter from "@registry/card/card-footer.astro";
import Input from "@registry/input/input.astro";
import Textarea from "@registry/textarea/textarea.astro";
import Checkbox from "@registry/checkbox/checkbox.astro";
import Switch from "@registry/switch/switch.astro";
import Label from "@registry/label/label.astro";
import Separator from "@registry/separator/separator.astro";
import Alert from "@registry/alert/alert.astro";
import AlertTitle from "@registry/alert/alert-title.astro";
import AlertDescription from "@registry/alert/alert-description.astro";
import Avatar from "@registry/avatar/avatar.astro";
import AvatarImage from "@registry/avatar/avatar-image.astro";
import AvatarFallback from "@registry/avatar/avatar-fallback.astro";
import Skeleton from "@registry/skeleton/skeleton.astro";
import Progress from "@registry/progress/progress.astro";
import Accordion from "@registry/accordion/accordion.astro";
import AccordionItem from "@registry/accordion/accordion-item.astro";
import AccordionTrigger from "@registry/accordion/accordion-trigger.astro";
import AccordionContent from "@registry/accordion/accordion-content.astro";
import Slider from "@registry/slider/slider.astro";
import Toggle from "@registry/toggle/toggle.astro";
import Breadcrumb from "@registry/breadcrumb/breadcrumb.astro";
import BreadcrumbList from "@registry/breadcrumb/breadcrumb-list.astro";
import BreadcrumbItem from "@registry/breadcrumb/breadcrumb-item.astro";
import BreadcrumbLink from "@registry/breadcrumb/breadcrumb-link.astro";
import BreadcrumbPage from "@registry/breadcrumb/breadcrumb-page.astro";
import BreadcrumbSeparator from "@registry/breadcrumb/breadcrumb-separator.astro";
import Pagination from "@registry/pagination/pagination.astro";
import PaginationContent from "@registry/pagination/pagination-content.astro";
import PaginationItem from "@registry/pagination/pagination-item.astro";
import PaginationLink from "@registry/pagination/pagination-link.astro";
import RadioGroup from "@registry/radio-group/radio-group.astro";
import RadioGroupItem from "@registry/radio-group/radio-group-item.astro";
import RegionWrap from "@/components/livecode/RegionWrap.astro";
import AtomGroup from "@/components/livecode/AtomGroup.astro";
import { ClickDockShell } from "@/components/livecode/ClickDockShell";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { FrameworkPicker } from "@/components/livecode/FrameworkPicker";
import { getSamples, getSample } from "@/samples";
import { prerenderFiles } from "@/lib/prerender-source";

const SECTION_LABEL: Record<string, string> = {
  "type-scale": "§01 Typography",
  "ticket-card": "§07 Cards · blocks",
  "stats-card": "§07 Cards · blocks",
  "upgrade-card": "§07 Cards · blocks",
};

const ALL_BLOCKS = getSamples({ kind: "block" });
const ALL_ATOMS = getSamples({ kind: "atom" });
const TYPE_SCALE = getSample("type-scale")!;
const COLOR_PALETTE = getSample("color-palette")!;
const TICKET_CARD = getSample("ticket-card")!;
const STATS_CARD = getSample("stats-card")!;
const UPGRADE_CARD = getSample("upgrade-card")!;
const ALERT_GALLERY = getSample("alert-gallery")!;
const NOTIFICATION_LIST = getSample("notification-list")!;
const CONFIRM_DIALOG = getSample("confirm-dialog")!;
const EMPTY_STATE = getSample("empty-state")!;
const COMMAND_PALETTE = getSample("command-palette")!;
const BADGE_COMPOSITIONS = getSample("badge-compositions")!;
const WORKSPACE_FORM = getSample("workspace-form")!;
const SELECTION_CONTROLS = getSample("selection-controls")!;
const SKELETON_CARD = getSample("skeleton-card")!;
const AVATAR_ROW = getSample("avatar-row")!;
const CONTEXT_MENU = getSample("context-menu")!
const TICKET_TABLE = getSample("ticket-table")!
const ONBOARDING_CARD = getSample("onboarding-card")!
const PROGRESS_CARD = getSample("progress-card")!
const ACCORDION_CARD = getSample("accordion-card")!
const BREADCRUMB_NAV = getSample("breadcrumb-nav")!
const PAGINATION_BAR = getSample("pagination-bar")!
const MACHINE_STATS = getSample("machine-stats")!
const TOOLTIP_CARD = getSample("tooltip-card")!;

const RAIL_REGIONS = await Promise.all([...ALL_BLOCKS, ...ALL_ATOMS].map(async (s) => ({
  id: s.id,
  label: s.title,
  section: SECTION_LABEL[s.id] ?? (s.kind === "atom" ? (s.relatedComponent ?? "Atoms") : "Blocks"),
  files: await prerenderFiles(s.spec, s.componentName, s.id),
})));

const typeScale = [
  { tag: "display/xl", cls: "font-serif italic font-medium text-[64px] leading-[1.02] tracking-[-0.022em]", size: "64/500", sample: "Composable state." },
  { tag: "display/lg", cls: "font-serif font-medium text-[48px] leading-[1.02] tracking-[-0.022em]", size: "48/500", sample: "State, without ceremony." },
  { tag: "h1", cls: "font-sans font-semibold text-[28px] tracking-[-0.02em]", size: "28/600", sample: "Ticket: Payment retry loop" },
  { tag: "h2", cls: "font-sans font-semibold text-[20px] tracking-[-0.015em]", size: "20/600", sample: "Transitions, guarded" },
  { tag: "body", cls: "font-sans text-[13px] leading-[1.55]", size: "13/400", sample: "Matchina handles state transitions, effects, and pattern matching — end-to-end typed." },
  { tag: "caption", cls: "font-sans text-[11px] text-muted-foreground", size: "11/400", sample: "Last edited 3 hours ago by kai." },
  { tag: "mono/sm", cls: "font-mono text-[11px]", size: "11/400", sample: "const fetcher = createMachine({ idle: …})" },
  { tag: "eyebrow", cls: "font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-text-mute", size: "10/500", sample: "now · shipping · api reference" },
];
---

<StarlightPage
  frontmatter={{
    title: "Kitchen Sink",
    description:
      "Every primitive on one page — components in their variants, sizes, and states.",
    template: "doc",
  }}
>
  <style is:global>
    /* Kitchen sink is a wide showcase — widen container when this page is mounted. */
    body:has(.ks-page) .main-frame .content-panel .sl-container { max-width: 1440px; }
  </style>

  <div class="ks-page">

  <BackToDocs />
  {/* ──────────────────────────────────────────────── Hero (full-width, above rail) */}
  <section class="not-content mb-12">
    <div class="font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute mb-3">
      Design system · Components reference · v0.4.0
    </div>
    <div class="font-serif font-medium text-[56px] leading-[1.02] tracking-[-0.022em] text-foreground">
      Every part, <span class="italic text-muted-foreground">on</span> <span class="italic">one page</span>.
    </div>
    <p class="max-w-[560px] mt-4 text-[15px] leading-[1.55] text-muted-foreground">
      A working preview of the components that ship with matchina. Pulled from real product
      surfaces: chat, tickets, docs, settings. Skim top-to-bottom for type, controls, data,
      and overlays.
    </p>
    <div class="flex gap-8 mt-5 font-mono text-[11px] text-muted-foreground">
      <span><span class="text-foreground">42</span> components</span>
      <span><span class="text-foreground">9</span> sections</span>
      <span><span class="text-foreground">2</span> themes</span>
      <span><span class="text-accent">●</span> blue accent</span>
    </div>
    <div class="mt-5">
      <FrameworkPicker client:load />
    </div>
  </section>

  <div class="ks-with-rail">
  <main class="ks-main">

  {/* ──────────────────────────────────────────────── 01 · Type (first block — type scale) */}
  <section class="not-content mb-10">
    <div class="flex items-center gap-2.5 mb-6 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§01</span>
      <span>Typography · type scale</span>
      <span class="flex-1 h-px bg-border" />
    </div>
    {/* Intro copy — outside the block region so it's not part of the source. */}
    <div class="mb-6">
      <div class="font-serif italic font-medium text-[32px] leading-[1.1] tracking-[-0.015em] text-foreground">Type scale</div>
      <div class="text-[13px] text-muted-foreground mt-1.5 max-w-[560px] leading-[1.5]">
        Newsreader for display + editorial voice. Geist for product UI. Geist Mono for meta, code, numerics.
      </div>
    </div>

    <RegionWrap id={TYPE_SCALE.id}>
      <BlockPreview spec={TYPE_SCALE.spec} client:load />
    </RegionWrap>
  </section>

  {/* ──────────────────────────────────────────────── 02 · Palette */}
  <section class="not-content mb-10">
    <div class="flex items-center gap-2.5 mb-6 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§02</span>
      <span>Palette</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <RegionWrap id={COLOR_PALETTE.id}>
      <BlockPreview spec={COLOR_PALETTE.spec} client:load />
    </RegionWrap>
  </section>

  {/* ──────────────────────────────────────────────── 03 · Buttons */}
  <section class="not-content mb-10">
    <div class="flex items-center gap-2.5 mb-6 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§03</span>
      <span>Buttons</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="pb-5 border-b border-border">
      <AtomGroup label="Variants" id="button-variants" />
      <AtomGroup label="Sizes" id="button-sizes" />

      <AtomGroup label="Toggle states" id="toggle-states" />
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 04 · Badges */}
  <section class="not-content my-10">
    <div class="flex items-center gap-2.5 mb-4 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§04</span>
      <span>Badges &amp; labels</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="pb-5 border-b border-border">
      <AtomGroup label="Variants" id="badge-variants" />

      {/* Usage examples — realistic compositions, not single atoms. */}
      <RegionWrap id={BADGE_COMPOSITIONS.id} class="mt-2">
        <BlockPreview spec={BADGE_COMPOSITIONS.spec} client:load />
      </RegionWrap>
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 05 · Fields */}
  <section class="not-content my-10">
    <div class="flex items-center gap-2.5 mb-4 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§05</span>
      <span>Fields &amp; forms</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="pb-5 mb-5 border-b border-border">
      <AtomGroup label="Input states" id="input-states" />
      <AtomGroup label="Input types" id="input-types" />
      <AtomGroup label="Textarea states" id="textarea-states" />
      <AtomGroup label="Label" id="label-compositions" />
      <AtomGroup label="Slider" id="slider-examples" />
    </div>

    <RegionWrap id={WORKSPACE_FORM.id} class="pb-5 border-b border-border">
      <BlockPreview spec={WORKSPACE_FORM.spec} client:load />
    </RegionWrap>
  </section>

  {/* ──────────────────────────────────────────────── 06 · Selection */}
  <section class="not-content my-10">
    <div class="flex items-center gap-2.5 mb-4 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§06</span>
      <span>Selection controls</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="pb-5 mb-5 border-b border-border">
      <AtomGroup label="Checkbox states" id="checkbox-states" />
      <AtomGroup label="Switch states" id="switch-states" />
      <AtomGroup label="Avatar sizes" id="avatar-examples" />
      <AtomGroup label="Skeleton" id="skeleton-examples" />
      <AtomGroup label="Separator" id="separator-examples" />
    </div>

    <RegionWrap id={SELECTION_CONTROLS.id} class="pb-5 border-b border-border">
      <BlockPreview spec={SELECTION_CONTROLS.spec} client:load />
    </RegionWrap>
  </section>

  {/* ──────────────────────────────────────────────── 07 · Cards · blocks */}
  <section class="not-content my-10">
    <div class="flex items-center gap-2.5 mb-4 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§07</span>
      <span>Cards · blocks</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <RegionWrap id={TICKET_CARD.id}>
        <BlockPreview spec={TICKET_CARD.spec} client:load />
      </RegionWrap>
      <RegionWrap id={STATS_CARD.id}>
        <BlockPreview spec={STATS_CARD.spec} client:load />
      </RegionWrap>
      <RegionWrap id={UPGRADE_CARD.id}>
        <BlockPreview spec={UPGRADE_CARD.spec} client:load />
      </RegionWrap>
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 08 · Productivity */}
  <section class="not-content my-14">
    <div class="flex items-center gap-2.5 mb-5 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§08</span>
      <span>Productivity surfaces</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="mb-6">
      <div class="font-serif italic font-medium text-[32px] leading-[1.1] tracking-[-0.015em] text-foreground">Tickets &amp; docs</div>
      <div class="text-[13px] text-muted-foreground mt-1.5 max-w-[560px] leading-[1.5]">
        How the components compose into real product views: a ticket list, a ticket detail, and a document.
      </div>
    </div>

    {/* Breadcrumb nav */}
    <div class="mb-3">
      <RegionWrap id={BREADCRUMB_NAV.id}>
        <BlockPreview spec={BREADCRUMB_NAV.spec} client:load />
      </RegionWrap>
    </div>

    {/* Ticket table */}
    <div class="mb-4">
      <RegionWrap id={TICKET_TABLE.id}>
        <BlockPreview spec={TICKET_TABLE.spec} client:load />
      </RegionWrap>
    </div>

    {/* Ticket table pagination */}
    <div class="mb-6">
      <RegionWrap id={PAGINATION_BAR.id}>
        <BlockPreview spec={PAGINATION_BAR.spec} client:load />
      </RegionWrap>
    </div>

    {/* Ticket detail + Document */}
    <div class="grid grid-cols-2 gap-5">
      {/* Ticket detail */}
      <div class="border border-border rounded bg-card overflow-hidden">
        <div class="px-5 py-3.5 border-b border-border">
          <div class="flex items-center gap-2 mb-2 font-mono text-[10px] tracking-[0.06em] uppercase text-text-mute">
            <span>MCN-142</span>
            <span>·</span>
            <Badge variant="outline" class="text-info">● In progress</Badge>
            <Badge variant="outline" class="text-warn">P1</Badge>
          </div>
          <div class="font-sans text-[22px] font-semibold tracking-[-0.015em] leading-[1.25] text-foreground">
            Payment retry loops past <code class="font-mono text-[18px] bg-code border border-border px-1">paying</code> → <code class="font-mono text-[18px] bg-code border border-border px-1">idle</code>
          </div>
        </div>
        <div class="p-5 text-[13.5px] leading-[1.65]">
          <p class="m-0 text-muted-foreground">
            When a component using <code class="font-mono bg-code border border-border px-1">useMachine(checkout)</code> unmounts between <em>paying</em> and <em>retry</em>, the machine is re-initialized and we get a spurious <em>idle → loading</em> hop in history.
          </p>
          <h3 class="font-sans text-[13px] font-semibold mt-4 mb-1.5 text-foreground">Repro</h3>
          <ol class="m-0 pl-5 text-muted-foreground">
            <li>Open <code class="font-mono bg-code border border-border px-1">examples/checkout</code></li>
            <li>Add an item, click <em>Pay</em></li>
            <li>Navigate away, back; click <em>Retry</em></li>
            <li>Inspect <code class="font-mono bg-code border border-border px-1">machine.history</code></li>
          </ol>
          <div class="flex items-center gap-2.5 my-3">
            <div class="flex-1 h-px bg-border" />
            <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-text-mute">Activity</div>
            <div class="flex-1 h-px bg-border" />
          </div>
          <div class="flex flex-col gap-2.5">
            {[
              { who: "JR", txt: "reproduced locally — looks like mount order in React 18", t: "12m" },
              { who: "KM", txt: "posted a patch: lift the machine out of the component", t: "8m" },
              { who: "✦", accent: true, txt: "Claude · linked this to MCN-140 (inference regression)", t: "3m" },
            ].map((a) => (
              <div class="flex gap-2.5 text-[12px] text-muted-foreground leading-[1.5]">
                <span class:list={[
                  "w-5 h-5 rounded-full grid place-items-center font-mono text-[10px] font-semibold flex-shrink-0 border border-border",
                  a.accent ? "bg-accent text-accent-ink" : "bg-muted text-foreground",
                ]}>{a.who}</span>
                <span class="flex-1">{a.txt}</span>
                <span class="font-mono text-[10px] text-text-mute">{a.t}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Document view */}
      <div class="border border-border rounded bg-card overflow-hidden">
        <div class="px-4 py-2.5 border-b border-border flex items-center gap-2 font-mono text-[11px] text-muted-foreground">
          <span class="text-foreground font-semibold">B</span>
          <span class="italic">I</span>
          <span class="underline">U</span>
          <span class="line-through">S</span>
          <span class="text-border">│</span>
          <span>H1</span><span>H2</span>
          <span class="text-border">│</span>
          <span>⌘</span><span>"</span><span>&lt;/&gt;</span>
          <span class="text-border">│</span>
          <Badge>● Claude edit</Badge>
          <span class="ml-auto">2 edits · saved</span>
        </div>
        <div class="px-5 py-5 text-[14px] leading-[1.65]">
          <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-text-mute mb-1.5">Post-mortem · Oct 17</div>
          <div class="font-serif font-medium text-[28px] tracking-[-0.015em] leading-[1.15] mb-2.5 text-foreground">
            Why our checkout machine forgot itself <em class="text-muted-foreground">for 4 milliseconds.</em>
          </div>
          <p class="m-0 mb-2.5 text-muted-foreground">
            <strong class="text-foreground font-semibold">tl;dr</strong> — a stale closure in the React binding caused the fetcher machine to remount between paying and retry, corrupting the transition log.
          </p>
          <h3 class="font-sans text-[14px] font-semibold mt-4 mb-1.5 text-foreground">Timeline</h3>
          <ul class="m-0 pl-5 text-muted-foreground">
            <li><strong class="text-foreground">14:02</strong> — user reports retry bug in #support</li>
            <li><strong class="text-foreground">14:08</strong> — repro confirmed by JR</li>
            <li><strong class="text-foreground">14:31</strong> — KM lands patch behind feature flag</li>
          </ul>
          <div class="mt-4 px-3 py-2.5 border-l-2 border-accent bg-accent-soft text-[12.5px]">
            <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-accent mb-1">Lesson</div>
            Never bind a machine to a component's lifetime. Always lift, or wire persistence.
          </div>
          <div class="mt-3.5 border border-dashed border-accent rounded px-3 py-2.5 text-[12.5px]">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="text-accent font-mono">✦</span>
              <span class="font-mono text-[10px] tracking-[0.08em] uppercase text-accent">Claude suggestion</span>
            </div>
            Add a code snippet showing the fix with <code class="font-mono bg-code border border-border px-1">useMachine(m, &#123; persist: 'checkout' &#125;)</code>.
            <div class="flex gap-1.5 mt-2">
              <Button size="sm">Accept</Button>
              <Button size="sm" variant="ghost">Dismiss</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 09 · Feedback & overlays */}
  <section class="not-content my-14">
    <div class="flex items-center gap-2.5 mb-5 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§09</span>
      <span>Feedback &amp; overlays</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    {/* Alerts */}
    <RegionWrap id={ALERT_GALLERY.id} class="mb-6">
      <BlockPreview spec={ALERT_GALLERY.spec} client:load />
    </RegionWrap>

    <div class="grid grid-cols-2 gap-5 mb-6">
      <RegionWrap id={NOTIFICATION_LIST.id}>
        <BlockPreview spec={NOTIFICATION_LIST.spec} client:load />
      </RegionWrap>
      <RegionWrap id={CONFIRM_DIALOG.id}>
        <BlockPreview spec={CONFIRM_DIALOG.spec} client:load />
      </RegionWrap>
    </div>

    {/* Machine stats + onboarding */}
    <div class="grid grid-cols-[1.2fr_1fr] gap-5 mb-6">
      <RegionWrap id={MACHINE_STATS.id}>
        <BlockPreview spec={MACHINE_STATS.spec} client:load />
      </RegionWrap>

      {/* Onboarding progress + steps */}
      <RegionWrap id={ONBOARDING_CARD.id}>
        <BlockPreview spec={ONBOARDING_CARD.spec} client:load />
      </RegionWrap>
    </div>

    {/* Skeleton loading states */}
    <div class="grid grid-cols-3 gap-5 mb-5">
      <RegionWrap id={SKELETON_CARD.id}>
        <BlockPreview spec={SKELETON_CARD.spec} client:load />
      </RegionWrap>

      <RegionWrap id={PROGRESS_CARD.id}>
        <BlockPreview spec={PROGRESS_CARD.spec} client:load />
      </RegionWrap>

      <RegionWrap id={ACCORDION_CARD.id}>
        <BlockPreview spec={ACCORDION_CARD.spec} client:load />
      </RegionWrap>
    </div>

    {/* Avatars */}
    <div class="mb-5">
      <RegionWrap id={AVATAR_ROW.id}>
        <BlockPreview spec={AVATAR_ROW.spec} client:load />
      </RegionWrap>
    </div>

    {/* Menu + Tooltip + Empty state */}
    <div class="grid grid-cols-3 gap-5">
      <RegionWrap id={CONTEXT_MENU.id}>
        <BlockPreview spec={CONTEXT_MENU.spec} client:load />
      </RegionWrap>

      <RegionWrap id={TOOLTIP_CARD.id}>
        <BlockPreview spec={TOOLTIP_CARD.spec} client:load />
      </RegionWrap>

      <RegionWrap id={EMPTY_STATE.id}>
        <BlockPreview spec={EMPTY_STATE.spec} client:load />
      </RegionWrap>
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 10 · Command palette */}
  <section class="not-content my-14">
    <div class="flex items-center gap-2.5 mb-5 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§10</span>
      <span>Command palette</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <RegionWrap id={COMMAND_PALETTE.id}>
      <BlockPreview spec={COMMAND_PALETTE.spec} client:load />
    </RegionWrap>
  </section>

  {/* Footer */}
  <div class="not-content mt-14 pt-6 border-t border-border flex justify-between font-mono text-[10px] text-text-mute tracking-[0.08em] uppercase">
    <span>Matchina Design System · v0.4.0</span>
    <span>end of kitchen sink</span>
  </div>
  </main>

  <aside class="ks-rail not-content">
    <div class="ks-rail-inner">
      <ClickDockShell client:load regions={RAIL_REGIONS} />
    </div>
  </aside>
  </div>

  <style is:global>
    /* Narrow: dim backdrop behind the drawer (pointer-events:none — click-outside handled in JS). */
    @media (max-width: 1099px) {
      body[data-rail-open="true"]::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 39;
        background: rgba(0,0,0,0.45);
        pointer-events: none;
      }
    }
    /* Narrow (<1100px): rail is a slide-up drawer pinned to the viewport bottom. */
    @media (max-width: 1099px) {
      .ks-rail {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        max-height: 70vh;
        height: 70vh;
        transform: translateY(calc(100% + 8px));
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
        background: hsl(var(--background));
        border-top: 1px solid hsl(var(--border));
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        box-shadow: 0 -8px 32px -4px rgba(0, 0, 0, 0.22);
        padding-top: 12px;
      }
      body[data-rail-open="true"] .ks-rail { transform: translateY(0); }
      body[data-rail-open="true"] { overflow: hidden; }
      .ks-rail { overscroll-behavior: contain; }
      .ks-rail .ks-rail-grabber { display: block; }
    }
    /* Narrow: rail-inner fills the drawer's 70vh. */
    @media (max-width: 1099px) {
      .ks-rail-inner { height: 100%; }
    }
    /* Wide (≥1100px): rail is the sticky right column. */
    @media (min-width: 1100px) {
      .ks-with-rail { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 1.5rem; }
      .ks-rail-inner { position: sticky; top: 5rem; height: calc(100vh - 6rem); }
    }
  </style>
</StarlightPage>
