        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        max-height: 70vh;
        height: 70vh;
        transform: translateY(calc(100% + 8px));
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
        background: hsl(var(--background));
        border-top: 1px solid hsl(var(--border));
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        box-shadow: 0 -8px 32px -4px rgba(0, 0, 0, 0.22);
        padding-top: 12px;
      }
      body[data-rail-open="true"] .ks-rail { transform: translateY(0); }
      .ks-rail .ks-rail-grabber { display: block; }
      .ks-rail .ks-rail-close { top: 10px; }
    }
    /* Narrow: rail-inner fills the drawer's 70vh. */
    @media (max-width: 1099px) {
      .ks-rail-inner { height: 100%; }
    }
    /* Wide (≥1100px): rail is the sticky right column. */
    @media (min-width: 1100px) {
