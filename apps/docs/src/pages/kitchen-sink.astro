            <span class:list={["font-mono text-[11px] w-3.5", m.danger ? "text-destructive" : "text-text-mute"]}>{m.i}</span>
            <span class="flex-1">{m.l}</span>
            <span class="font-mono text-[10px] text-text-mute">{m.k}</span>
          </div>
        ))}
        <div class="h-4" />
      </div>

      <Card>
        <CardHeader>
          <CardDescription class="font-mono text-[10px] tracking-[0.08em] uppercase text-text-mute">Tooltip</CardDescription>
          <CardTitle>Hover states</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="flex gap-5 items-center py-5">
            <div class="relative">
              <Button variant="outline">↑ Assign</Button>
              <div class="absolute bottom-[calc(100%+8px)] left-1/2 -translate-x-1/2 bg-foreground text-background px-2 py-1 text-[11px] whitespace-nowrap">
                Assign ticket <span class="font-mono text-text-mute ml-1">A</span>
              </div>
            </div>
            <Button variant="outline">🕮 Docs</Button>
            <Button variant="outline">⌘ ⌘K</Button>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardDescription class="font-mono text-[10px] tracking-[0.08em] uppercase text-text-mute">Empty state</CardDescription>
          <CardTitle>No tickets match</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="py-2.5 text-center">
            <div class="mx-auto mb-3 w-10 h-10 border border-dashed border-border grid place-items-center text-text-mute font-mono text-[14px] rounded">∅</div>
            <div class="text-[13px] text-foreground font-medium mb-1">Nothing here yet</div>
            <div class="text-[12px] text-muted-foreground mb-3">Try loosening the filter, or let Claude draft a ticket for you.</div>
            <div class="flex gap-1.5 justify-center">
              <Button size="sm" variant="ghost">Clear filters</Button>
              <Button size="sm">✦ Draft with Claude</Button>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  {/* ──────────────────────────────────────────────── 10 · Command palette */}
  <section class="not-content my-14">
    <div class="flex items-center gap-2.5 mb-5 font-mono text-[10px] tracking-[0.12em] uppercase text-text-mute">
      <span class="text-accent">§10</span>
      <span>Command palette</span>
      <span class="flex-1 h-px bg-border" />
    </div>

    <div class="max-w-[720px] border border-border rounded bg-card overflow-hidden">
      <div class="px-4 py-3 border-b border-border flex items-center gap-2.5">
        <span class="text-text-mute font-mono">/</span>
        <span class="flex-1 text-[14px] text-foreground">ask claude to refactor checkout.ts</span>
        <kbd class="font-mono text-[10px] border border-border px-1.5 py-px text-muted-foreground bg-muted rounded">↵</kbd>
      </div>
      {[
        { ico: "✦", l: "Ask Claude", s: "Free-form prompt with current file", k: "⌘↵", active: true },
        { ico: "⤓", l: "Apply fix", s: "Use the suggestion from turn 6", k: "⌥↵" },
        { ico: "⎘", l: "Copy as markdown", s: "Conversation export", k: "⇧⎘" },
        { ico: "↗", l: "Open in new ticket", s: "From conversation thread", k: "⌘N" },
        { ico: "⌕", l: "Search tickets", s: "Text · labels · assignee", k: "⌘P" },
      ].map((c, i, arr) => (
        <div class:list={[
          "px-4 py-2 flex items-center gap-3.5",
          i < arr.length - 1 && "border-b border-border",
          c.active && "bg-muted",
        ]}>
          <span class="text-accent font-mono text-[14px] w-4">{c.ico}</span>
          <span class="flex-1">
            <span class="block text-[13px] text-foreground">{c.l}</span>
            <span class="block text-[11px] text-muted-foreground mt-0.5">{c.s}</span>
          </span>
          <kbd class="font-mono text-[10px] border border-border px-1.5 py-px text-muted-foreground bg-muted rounded">{c.k}</kbd>
        </div>
      ))}
    </div>
  </section>

  {/* Footer */}
  <div class="not-content mt-14 pt-6 border-t border-border flex justify-between font-mono text-[10px] text-text-mute tracking-[0.08em] uppercase">
    <span>Matchina Design System · v0.4.0</span>
    <span>end of kitchen sink</span>
  </div>
  </main>

  <aside class="ks-rail not-content">
    <div class="ks-rail-inner">
      <ClickDockShell client:load regions={RAIL_REGIONS} />
    </div>
  </aside>
  </div>

  <style is:global>
    /* Narrow (<1100px): rail is a slide-up drawer pinned to the viewport bottom. */
    @media (max-width: 1099px) {
      .ks-rail {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        max-height: 70vh;
        height: 70vh;
        transform: translateY(100%);
        transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
        background: hsl(var(--background));
        border-top: 1px solid hsl(var(--border));
        box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.18);
      }
      body[data-rail-open="true"] .ks-rail { transform: translateY(0); }
    }
    /* Narrow: rail-inner fills the drawer's 70vh. */
    @media (max-width: 1099px) {
      .ks-rail-inner { height: 100%; }
    }
    /* Wide (≥1100px): rail is the sticky right column. */
    @media (min-width: 1100px) {
      .ks-with-rail { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 1.5rem; }
      .ks-rail-inner { position: sticky; top: 5rem; height: calc(100vh - 6rem); }
    }
  </style>
</StarlightPage>
