---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ExampleViewer from "@/components/livecode/ExampleViewer.astro";
import { getSamples } from "@/samples";
import { prerenderFiles } from "@/lib/prerender-source";

export async function getStaticPaths() {
  const all = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);
  return all.map((b) => ({ params: { id: b.id } }));
}

const { id } = Astro.params;
const ALL = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);
const sample = ALL.find((b) => b.id === id);
if (!sample) {
  return Astro.redirect("/examples");
}

const CATEGORY_ORDER = [
  "Cards", "Forms", "Marketing", "Feedback", "Productivity",
  "AI", "Navigation", "Overlays", "People", "Design System",
];
const known = new Set(CATEGORY_ORDER);
const extra = Array.from(new Set(ALL.map((b) => b.category ?? "Other"))).filter((c) => !known.has(c));

const GROUPED = [...CATEGORY_ORDER, ...extra]
  .map((cat) => ({
    category: cat,
    blocks: ALL
      .filter((b) => (b.category ?? "Other") === cat)
      .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
  }))
  .filter((g) => g.blocks.length > 0);

const files = await prerenderFiles(sample.spec, sample.componentName, sample.id);
const region = {
  id: sample.id,
  label: sample.title,
  section: sample.category ?? "Example",
  files,
};
---

<StarlightPage
  frontmatter={{
    title: sample.title,
    description: sample.description,
    template: "splash",
  }}
>
  <div class="ex-shell not-content">

    <aside class="ex-sidebar" id="ex-sidebar">
      <div class="ex-sidebar-header">
        <a href="/examples" class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors">
          ← Examples
        </a>
        <button class="ex-sidebar-close" aria-label="Close navigation" aria-controls="ex-sidebar">✕</button>
      </div>
      <nav class="ex-sidebar-nav">
        {GROUPED.map((group) => (
          <div class="mb-5">
            <div class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground mb-1.5 px-2">
              {group.category}
            </div>
            <ul>
              {group.blocks.map((b) => (
                <li>
                  <a
                    href={`/examples/${b.id}`}
                    class:list={[
                      "block px-2 py-1 text-[12.5px] leading-snug rounded-sm transition-colors",
                      b.id === sample.id
                        ? "text-foreground bg-muted/60 font-medium"
                        : "text-muted-foreground hover:text-foreground hover:bg-muted/30",
                    ]}
                  >
                    {b.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main class="ex-main">
      <div class="ex-viewer-wrap">
        <ExampleViewer
          spec={sample.spec}
          region={region}
          title={sample.title}
          description={sample.description}
          deps={sample.registryDependencies ?? []}
        />
      </div>
    </main>

  </div>
</StarlightPage>

<style is:inline>
  [data-page-title], h1#_top { display: none !important; }
</style>

<style is:global>
  body:has(.ex-shell) .main-frame { padding-top: 0 !important; }
  body:has(.ex-shell) .content-panel { padding: 0 !important; border: 0 !important; }
  body:has(.ex-shell) .sl-container { max-width: none !important; padding: 0 !important; margin: 0 !important; }

  .ex-shell {
    position: fixed;
    top: var(--sl-nav-height);
    left: 0; right: 0; bottom: 0;
    display: flex;
    overflow: hidden;
    background: hsl(var(--background));
  }

  /* ── sidebar ── */
  .ex-sidebar {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid hsl(var(--border));
    overflow: hidden;
    background: hsl(var(--background));
  }
  .ex-sidebar-header {
    padding: 12px 16px;
    border-bottom: 1px solid hsl(var(--border));
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ex-sidebar-close {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: hsl(var(--muted-foreground));
    font-size: 13px;
    line-height: 1;
    padding: 2px 4px;
  }
  .ex-sidebar-close:hover { color: hsl(var(--foreground)); }
  .ex-sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 16px 10px 24px;
  }

  /* ── main ── */
  .ex-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
.ex-viewer-wrap {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .ex-viewer-wrap > * {
    flex: 1;
    min-height: 0;
  }

  /* ── narrow: slide-in sidebar, show mobile bar ── */
  @media (max-width: 1023px) {
    .ex-sidebar {
      position: absolute;
      top: 0; left: 0; bottom: 0;
      z-index: 10;
      transform: translateX(-100%);
      transition: transform 0.2s ease-out;
    }
    .ex-sidebar.is-open {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0,0,0,0.25);
    }
    .ex-sidebar-close { display: block; }
    .ex-mobile-bar { display: flex; }
}
</style>

<script>
  const toggle = document.querySelector('.ex-nav-toggle');
  const close = document.querySelector('.ex-sidebar-close');
  const sidebar = document.getElementById('ex-sidebar');
  function open() { sidebar?.classList.add('is-open'); toggle?.setAttribute('aria-expanded', 'true'); }
  function shut() { sidebar?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); }
  toggle?.addEventListener('click', open);
  close?.addEventListener('click', shut);
  sidebar?.querySelectorAll('a').forEach(a => a.addEventListener('click', shut));
</script>
