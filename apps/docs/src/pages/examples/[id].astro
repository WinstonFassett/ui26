---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ExampleViewer } from "@/components/livecode/ExampleViewer";
import { getSamples } from "@/samples";
import { prerenderFiles } from "@/lib/prerender-source";
import { CLI_ADD } from "@/lib/site";

export async function getStaticPaths() {
  const all = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);
  return all.map((b) => ({ params: { id: b.id } }));
}

const { id } = Astro.params;
const ALL = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);
const sample = ALL.find((b) => b.id === id);
if (!sample) {
  return Astro.redirect("/examples");
}

const CATEGORY_ORDER = [
  "Cards", "Forms", "Marketing", "Feedback", "Productivity",
  "AI", "Navigation", "Overlays", "People", "Design System",
];
const known = new Set(CATEGORY_ORDER);
const extra = Array.from(new Set(ALL.map((b) => b.category ?? "Other"))).filter((c) => !known.has(c));

const GROUPED = [...CATEGORY_ORDER, ...extra]
  .map((cat) => ({
    category: cat,
    blocks: ALL
      .filter((b) => (b.category ?? "Other") === cat)
      .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
  }))
  .filter((g) => g.blocks.length > 0);

const files = await prerenderFiles(sample.spec, sample.componentName, sample.id);
const region = {
  id: sample.id,
  label: sample.title,
  section: sample.category ?? "Example",
  files,
};
const cliCmd = `${CLI_ADD} ${sample.id}`;
---

<StarlightPage
  frontmatter={{
    title: sample.title,
    description: sample.description,
    template: "splash",
    hero: {},
  }}
>
  <div class="ex-shell not-content">

    <!-- sidebar -->
    <aside class="ex-sidebar">
      <div class="ex-sidebar-header">
        <a href="/examples" class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground hover:text-foreground transition-colors">
          ← Examples
        </a>
      </div>
      <nav class="ex-sidebar-nav">
        {GROUPED.map((group) => (
          <div class="mb-5">
            <div class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground mb-1.5 px-2">
              {group.category}
            </div>
            <ul>
              {group.blocks.map((b) => (
                <li>
                  <a
                    href={`/examples/${b.id}`}
                    class:list={[
                      "block px-2 py-1 text-[12.5px] leading-snug rounded-sm transition-colors",
                      b.id === sample.id
                        ? "text-foreground bg-muted/60 font-medium"
                        : "text-muted-foreground hover:text-foreground hover:bg-muted/30",
                    ]}
                  >
                    {b.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- main -->
    <main class="ex-main">
      <header class="ex-main-header">
        <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
          {sample.category ?? "Example"}
        </span>
        <span class="font-mono text-[10px] text-muted-foreground/40 mx-1.5">/</span>
        <span class="font-mono text-[10px] uppercase tracking-widest text-foreground">
          {sample.title}
        </span>
      </header>

      <div class="ex-main-body">
        <ExampleViewer
          spec={sample.spec}
          region={region}
          title={sample.title}
          description={sample.description}
          cliCmd={cliCmd}
          deps={sample.registryDependencies ?? []}
          client:load
        />
      </div>
    </main>

  </div>

  <style is:global>
    /* Make the viewer a fixed two-pane shell below the nav */
    body:has(.ex-shell) .main-frame { padding-top: 0 !important; }
    body:has(.ex-shell) .content-panel { padding: 0 !important; border: 0 !important; }
    body:has(.ex-shell) .sl-container { max-width: none !important; padding: 0 !important; margin: 0 !important; }

    /* Two-pane shell: fixed, starting just below the sticky nav */
    .ex-shell {
      position: fixed;
      top: var(--sl-nav-height);
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      overflow: hidden;
    }

    /* Sidebar */
    .ex-sidebar {
      width: 220px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid hsl(var(--border));
      background: hsl(var(--background));
      overflow: hidden;
    }
    .ex-sidebar-header {
      padding: 12px 16px;
      border-bottom: 1px solid hsl(var(--border));
      flex-shrink: 0;
    }
    .ex-sidebar-nav {
      flex: 1;
      overflow-y: auto;
      padding: 16px 10px 24px;
    }

    /* Main column */
    .ex-main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .ex-main-header {
      display: flex;
      align-items: center;
      padding: 0 24px;
      height: 36px;
      border-bottom: 1px solid hsl(var(--border));
      background: hsl(var(--background));
      flex-shrink: 0;
    }
    .ex-main-body {
      flex: 1;
      overflow: hidden;
      padding: 24px;
      display: flex;
      flex-direction: column;
    }

    /* Narrow: hide sidebar */
    @media (max-width: 1023px) {
      .ex-sidebar { display: none; }
    }
  </style>
</StarlightPage>
