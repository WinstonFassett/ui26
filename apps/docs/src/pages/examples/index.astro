---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { BlockPreview } from "@/components/livecode/BlockPreview";
import { getSamples } from "@/samples";

const CATEGORY_ORDER = [
  "Cards",
  "Forms",
  "Marketing",
  "Feedback",
  "Productivity",
  "AI",
  "Navigation",
  "Overlays",
  "People",
  "Design System",
];

const ALL = getSamples({ kind: "block" }).filter((b) => b.indexable !== false);

const known = new Set(CATEGORY_ORDER);
const extra = Array.from(new Set(ALL.map((b) => b.category ?? "Other"))).filter((c) => !known.has(c));

const GROUPED = [...CATEGORY_ORDER, ...extra]
  .map((cat) => ({
    category: cat,
    blocks: ALL
      .filter((b) => (b.category ?? "Other") === cat)
      .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
  }))
  .filter((g) => g.blocks.length > 0);

// For each group, compute which cards are alone on their row so we can widen them.
// Grid is 2 cols. Full items consume 2 cols; auto items consume 1.
// An auto item is "lone" when it starts a row and no auto item follows in the same row.
function computeLone(blocks: typeof GROUPED[0]["blocks"]): boolean[] {
  const lone: boolean[] = new Array(blocks.length).fill(false);
  let col = 0; // 0-based column cursor (0 or 1 in a 2-col grid)
  for (let i = 0; i < blocks.length; i++) {
    const isFull = blocks[i].span === "full";
    if (isFull) {
      col = 0; // full always resets to start of next row
    } else {
      if (col === 0) {
        // starts a row — check if next item also auto and fits
        const nextIsAuto = i + 1 < blocks.length && blocks[i + 1].span !== "full";
        if (!nextIsAuto) lone[i] = true;
        else col = 1;
      } else {
        col = 0; // second col, next item starts fresh row
      }
    }
  }
  return lone;
}
---

<StarlightPage
  frontmatter={{
    title: "Examples",
    description: "Composed, installable UI patterns across React, Svelte, Astro, and JSON Render.",
    template: "splash",
    hero: {},
  }}
>
  <div class="examples-index">
    <section class="not-content mb-12">
      <div class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted-foreground mb-3">
        ui26 · examples
      </div>
      <div class="font-serif font-medium text-[48px] leading-[1.04] tracking-[-0.022em] text-foreground">
        Composed patterns, <span class="italic text-muted-foreground">in every framework</span>.
      </div>
      <p class="max-w-[640px] mt-4 text-[15px] leading-[1.55] text-muted-foreground">
        Browse layouts and compositions built from ui26 primitives. Open any example to see Preview and source in React, Svelte, Astro, or JSON Render.
      </p>
    </section>

    {GROUPED.map((group) => {
      const lone = computeLone(group.blocks);
      return (
        <section class="mb-12 not-content">
          <header class="mb-5 flex items-baseline justify-between border-b border-border pb-2">
            <h2 class="font-serif text-[22px] font-medium tracking-tight">{group.category}</h2>
            <span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              {group.blocks.length} example{group.blocks.length === 1 ? "" : "s"}
            </span>
          </header>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            {group.blocks.map((b, i) => (
              <a
                href={`/examples/${b.id}`}
                class:list={[
                  "ex-card group relative block border border-border bg-card hover:border-accent transition-colors overflow-hidden",
                  (b.span === "full" || lone[i]) && "lg:col-span-2",
                ]}
              >
                <div class:list={["ex-card-preview pointer-events-none overflow-hidden p-6", b.span === "full" && "ex-card-preview--full"]}>
                  <BlockPreview spec={b.spec} client:only="react" />
                </div>
                <div class="ex-card-info absolute bottom-0 left-0 right-0 flex flex-col gap-0.5 px-4 py-3 bg-card/90 backdrop-blur-sm border-t border-border translate-y-full group-hover:translate-y-0 transition-transform duration-150">
                  <span class="text-[13px] font-medium text-foreground leading-snug">{b.title}</span>
                  {b.description && (
                    <span class="text-[11px] text-muted-foreground leading-snug">{b.description}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <style is:global>
    body:has(.examples-index) .main-frame .content-panel .sl-container { max-width: 1280px; }
    .ex-card-preview { pointer-events: none; max-height: 360px; }
    .ex-card-preview--full { max-height: 520px; }
  </style>
</StarlightPage>
