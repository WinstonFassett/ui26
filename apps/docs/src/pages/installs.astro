---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ThemeSwitcher } from "@/components/kibo-ui/theme-switcher";
import { ReasoningDemo } from "@/components/demos/reasoning-demo";
import { ListDemo } from "@/components/demos/list-demo";
import { TableDemo } from "@/components/demos/table-demo";
import { TypographyDemo } from "@/components/demos/typography-demo";
import { TagsDemo } from "@/components/demos/tags-demo";
import { CodeBlockDemo } from "@/components/demos/code-block-demo";
---

<StarlightPage frontmatter={{ title: "Install spike", template: "splash" }}>
  <section style="padding: 2rem 0; display: grid; gap: 2.5rem;">
    <div>
      <h2>Kibo theme-switcher</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/theme-switcher.json</code>.
        No edits to the component source.
      </p>
    </div>
    <div class="not-content">
      <ThemeSwitcher client:only="react" className="w-fit" />
    </div>

    <div>
      <h2>AI Elements reasoning</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://elements.ai-sdk.dev/api/registry/reasoning.json</code>.
        No edits to the component source.
      </p>
    </div>
    <div class="not-content">
      <ReasoningDemo client:only="react" />
    </div>

    <div>
      <h2>Kibo list (Linear-style)</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/list.json</code>.
        No edits to the component source. Drag tickets between status columns.
      </p>
    </div>
    <div class="not-content">
      <ListDemo client:only="react" />
    </div>

    <div>
      <h2>Kibo table (sortable)</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/table.json</code>.
        Transitively installs shadcn <code>button</code>, <code>dropdown-menu</code>, and <code>table</code> primitives.
        Click any column header to sort.
      </p>
    </div>
    <div class="not-content">
      <TableDemo client:only="react" />
    </div>

    <div>
      <h2>Kibo typography (registry:style)</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/typography.json</code>.
        A <code>registry:style</code> entry — shadcn injects CSS directly into <code>global.css</code>.
        Apply with <code>class="typography"</code> on any container; opt-out with <code>.not-typography</code>.
      </p>
    </div>
    <div class="not-content">
      <TypographyDemo />
    </div>

    <div>
      <h2>Kibo tags (multi-select)</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/tags.json</code>.
        Transitively installs shadcn <code>badge</code>, <code>dialog</code>, <code>popover</code>, <code>command</code>.
        Click the trigger to open the cmdk picker; X to remove.
      </p>
    </div>
    <div class="not-content">
      <TagsDemo client:only="react" />
    </div>

    <div>
      <h2>Kibo code-block (Shiki)</h2>
      <p style="color: var(--muted-foreground); font-size: 0.875rem;">
        Installed via <code>npx shadcn add https://www.kibo-ui.com/r/code-block.json</code>.
        Shiki syntax highlighting, file tabs, copy button. Three file types swap in place.
      </p>
    </div>
    <div class="not-content">
      <CodeBlockDemo client:only="react" />
    </div>
  </section>
</StarlightPage>
